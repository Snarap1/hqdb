<?xml version="1.0"?>
<!--
  Turns off ClickHouse's own system log tables for the e2e fixture.
  Left on, an idle server keeps flushing and merging them and burns
  about half a CPU core on a small host. The e2e suite never reads them.
-->
<clickhouse>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <latency_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <error_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <processors_profile_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <s3queue_log remove="1"/>
    <crash_log remove="1"/>
</clickhouse>
